ADG_ENV=local
ADG_SERVICE_NAME=AI Data Access Gateway
ADG_CONTROL_PLANE_DATABASE_URL=sqlite:///./data/adg-control-plane.db
ADG_API_KEY_HEADER=X-ADG-API-Key
ADG_SECRET_KEY=
ADG_CREDENTIAL_ENCRYPTION_KEY=
ADG_LOG_LEVEL=INFO
ADG_SQL_ALLOW_CREATE=false
ADG_SQL_ALLOW_UPDATE=false
ADG_SQL_ALLOW_INSERT=false
ADG_SQL_STRICT_VALIDATION=true
ADG_BACKEND_PORT=8000
ADG_BACKEND_HOST_PORT=8000
ADG_WEB_PORT=8080
PYPI_INDEX_URL=https://pypi.org/simple
NPM_REGISTRY_URL=https://registry.npmjs.org/
